#!/bin/sh
# scripts/tokcron - run the Tokenomics job's entry point from Windows Git Bash
# (MSYS) or any POSIX shell outside WSL. Inside WSL, call ~/.local/bin/tokcron.
#
# Every argument reaches WSL as argv, untouched: MSYS path conversion is off
# (MSYS_NO_PATHCONV / MSYS2_ARG_CONV_EXCL), `--cd '~'` is quoted so this shell
# never expands it, and `wsl.exe --exec` runs the target with no Linux shell
# in between. So no `$`, quote or path argument can be rewritten on the way.
#
#   SBO_WSL_DISTRO   the WSL distro (default Ubuntu-20.04)
#   SBO_TOKCRON_EXEC the target, relative to the WSL home (default
#                    ./.local/bin/tokcron, written by `tokcron install`)
if [ -n "${WSL_DISTRO_NAME:-}" ]; then
  exec "$HOME/.local/bin/tokcron" "$@"
fi
MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' exec wsl.exe -d "${SBO_WSL_DISTRO:-Ubuntu-20.04}" \
  --cd '~' --exec "${SBO_TOKCRON_EXEC:-./.local/bin/tokcron}" "$@"
