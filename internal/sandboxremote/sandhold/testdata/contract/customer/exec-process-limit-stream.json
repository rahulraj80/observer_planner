{
  "name": "exec-process-limit-stream",
  "about": "The same when the output is streamed: the exit event carries error, code and fix.",
  "method": "POST",
  "path": "/v1/sandboxes/<id>/exec",
  "accept": "text/event-stream",
  "request": {
    "command": "sandhold-fake-pids"
  },
  "status": 200,
  "stream": [
    {
      "data": {
        "text": "building\n"
      },
      "event": "stdout"
    },
    {
      "data": {
        "code": "sandbox_process_limit",
        "durationMs": 0,
        "error": "the sandbox reached its process limit while the command ran",
        "exitCode": 1,
        "fix": "start fewer processes at once"
      },
      "event": "exit"
    }
  ]
}
