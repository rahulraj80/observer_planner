{
  "name": "sandbox-create",
  "about": "Start a sandbox from a template; the create's own fields win. Its metadata labels stay on the sandbox.",
  "method": "POST",
  "path": "/v1/sandboxes",
  "request": {
    "metadata": {
      "observer-run": "run-7f3a"
    },
    "template": "py-tests",
    "timeoutSeconds": 600
  },
  "status": 201,
  "response": {
    "createdAt": "<time>",
    "engine": "runc",
    "expiresAt": "<time>",
    "id": "<id>",
    "image": "sandhold/sandbox:dev",
    "isolation": "shielded",
    "isolationMeans": "a hardened container on the host's kernel",
    "metadata": {
      "observer-run": "run-7f3a"
    },
    "network": "limited",
    "owner": "alice",
    "runsOn": "runc",
    "startedBy": {
      "api": "native",
      "keyId": "<key-id>",
      "tool": "observer on laptop",
      "via": "key",
      "words": "Observer on laptop"
    },
    "state": "Running",
    "target": "runc"
  }
}
