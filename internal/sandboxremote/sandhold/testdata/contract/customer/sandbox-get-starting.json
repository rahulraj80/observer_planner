{
  "name": "sandbox-get-starting",
  "about": "A sandbox still starting.",
  "method": "GET",
  "path": "/v1/sandboxes/<id>",
  "status": 200,
  "response": {
    "createdAt": "<time>",
    "engine": "runc",
    "expiresAt": "<time>",
    "id": "<id>",
    "image": "sandhold/sandbox:dev",
    "isolation": "shielded",
    "isolationMeans": "a hardened container on the host's kernel",
    "network": "none",
    "owner": "alice",
    "runsOn": "runc",
    "startedBy": {
      "api": "native",
      "keyId": "<key-id>",
      "tool": "observer on laptop",
      "via": "key",
      "words": "Observer on laptop"
    },
    "state": "Starting"
  }
}
