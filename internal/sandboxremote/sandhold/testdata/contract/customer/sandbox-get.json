{
  "name": "sandbox-get",
  "about": "One sandbox.",
  "method": "GET",
  "path": "/v1/sandboxes/<id>",
  "status": 200,
  "response": {
    "createdAt": "<time>",
    "engine": "runc",
    "expiresAt": "<time>",
    "id": "<id>",
    "image": "sandhold/sandbox:dev",
    "isolation": "shielded",
    "isolationMeans": "a hardened container on the host's kernel",
    "metadata": {
      "observer-run": "run-7f3a"
    },
    "network": "limited",
    "owner": "alice",
    "runsOn": "runc",
    "state": "Running"
  }
}
