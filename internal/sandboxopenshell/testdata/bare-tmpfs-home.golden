# policy.yaml
version: 1
filesystem_policy:
  include_workdir: false
  read_only:
    - "/usr"
    - "/lib"
    - "/lib64"
    - "/bin"
    - "/sbin"
    - "/etc"
    - "/proc"
    - "/dev"
    - "/run"
    - "/var"
    - "/tmp/observer-sbx-RUN"
  read_write:
    - "/tmp"
    - "/dev/null"
    - "/dev/pts"
    - "/home/dev"
    - "/srv/work"
landlock:
  compatibility: hard_requirement
process:
  run_as_user: "1000"
  run_as_group: "1000"
# driver-config-json
{"docker":{"mounts":[{"type":"tmpfs","target":"/home/dev","mode":1023},{"type":"bind","source":"/srv/work","target":"/srv/work","read_only":false},{"type":"bind","source":"/tmp/observer-sbx-RUN","target":"/tmp/observer-sbx-RUN","read_only":true}]}}
# copy-sync
# shared-home
true
# create-argv
openshell
-g
openshell
sandbox
create
--name
sbo-ri6lvslpepzlnlq
--policy
/home/dev/.observer/sandbox-openshell/runs/RUN/policy.yaml
--driver-config-json
{"docker":{"mounts":[{"type":"tmpfs","target":"/home/dev","mode":1023},{"type":"bind","source":"/srv/work","target":"/srv/work","read_only":false},{"type":"bind","source":"/tmp/observer-sbx-RUN","target":"/tmp/observer-sbx-RUN","read_only":true}]}}
--label
observer.superbased.install=o0123456789abcdefo
--label
observer.superbased.run=o-RunSENTINEL0000_aao
--no-auto-providers
--no-keep
--tty
--env
HOME=/home/dev
--
/home/dev/.observer/bin/observer
sandbox-guest
--
claude
